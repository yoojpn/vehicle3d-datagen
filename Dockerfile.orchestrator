FROM python:3.11-slim

RUN git clone https://github.com/yoojpn/vehicle3d-datagen.git /workspace/repo || \
    (apt-get update && apt-get install -y git && git clone https://github.com/yoojpn/vehicle3d-datagen.git /workspace/repo)

WORKDIR /workspace/repo
CMD ["python3", "dataset_gen/orchestrator.py"]
