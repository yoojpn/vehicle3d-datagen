FROM nvidia/cuda:12.1.0-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    curl \
    git \
    wget \
    xz-utils \
    libxi6 \
    libxrender1 \
    libxfixes3 \
    libxkbcommon0 \
    libgl1 \
    libsm6 \
    python3 \
    python3-pip \
    git \
    && rm -rf /var/lib/apt/lists/*

RUN wget -q https://download.blender.org/release/Blender5.2/blender-5.2.0-linux-x64.tar.xz -O /tmp/blender.tar.xz \
    && tar xf /tmp/blender.tar.xz -C /opt \
    && rm /tmp/blender.tar.xz
ENV PATH="/opt/blender-5.2.0-linux-x64:${PATH}"

RUN pip3 install --no-cache-dir runpod trimesh numpy

RUN git clone https://github.com/yoojpn/vehicle3d-datagen.git /workspace/repo
RUN chmod +x /workspace/repo/dataset_gen/pod_run_and_terminate.sh /workspace/repo/dataset_gen/minimal_terminate_test.sh /workspace/repo/dataset_gen/timing_diagnostic.sh /workspace/repo/dataset_gen/isolated_render_test.sh

WORKDIR /workspace
COPY dataset_gen/serverless_handler.py /workspace/repo/dataset_gen/serverless_handler.py

CMD ["python3", "/workspace/repo/dataset_gen/serverless_handler.py"]
# cache bust 1785748534
